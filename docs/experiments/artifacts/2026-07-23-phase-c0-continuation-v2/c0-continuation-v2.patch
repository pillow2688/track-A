+                "outcome": {"class": "BENEFICIAL_CORRECTNESS"},
+                "future_latency": 1,
+                "candidate_promoted": True,
+                "followup_patch": "secret future patch",
+                "final_result": "PASS",
+            }
+        )
+        self.assertEqual(
