# Copy to .env for local use only. Never commit the populated .env file.
# Every value below is a placeholder or a non-secret default.
OPENAI_BASE_URL=https://provider.example.invalid/v1
OPENAI_API_KEY=replace-with-provider-api-key
LLM4HLS_MODEL=replace-with-approved-model-id

# Point at an externally installed AMD Vitis 2025.2 tree. Vitis is not in the image.
LLM4HLS_VITIS_HLS_ROOT=/absolute/path/to/AMD/2025.2/Vitis
LLM4HLS_TOOLCHAIN_ID=Vitis 2025.2
LLM4HLS_PART=xcu55c-fsvh2892-2L-e
LLM4HLS_CLOCK_NS=5.0

# Persist all clean-room artifacts through the /outputs bind mount.
LLM4HLS_OUTPUT_DIR=/outputs

# Read-only runtime mounts used by the clean-room commands. The official
# public corpus and repository source are deliberately not copied into the image.
LLM4HLS_OFFICIAL_CORPUS_ROOT=/official-corpus
LLM4HLS_SOURCE_ROOT=/workspace

# Wrapper/preflight bounds. Stage bounds for a real V3 run are CLI flags; see README.
LLM4HLS_DEMO_BATCH_TIMEOUT_S=120
LLM4HLS_DEMO_SMOKE_TIMEOUT_S=180
LLM4HLS_OFFICIAL_BATCH_TIMEOUT_S=180
LLM4HLS_OFFICIAL_SMOKE_TIMEOUT_S=240
LLM4HLS_QUICK_TEST_TIMEOUT_S=900
LLM4HLS_PREFLIGHT_TIMEOUT_S=60
